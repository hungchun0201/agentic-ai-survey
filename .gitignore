# Source materials (PDFs, cloned paper repos)
papers/*/paper.pdf
papers/*/repo/

# Large cloned repos (vllm, sglang, etc.)
repos/

# Experiment data
vllm-continuum/

# Build scripts & translations (local tooling, not deployed)
scripts/
translations/
plan/

# OS junk
.DS_Store

# Paper-page auto-review loop staging
.review-stage/
papers/*/REVIEW_REMAINING.md

# Bullet guide build scaffolding (full paper text/PDF, evidence, section sources)
papers/bullet/guide/_src/

# reproduction harnesses + report bundles (do not push)
papers/*/repro/
papers/*/report/
